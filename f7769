// Animated caption layers as rasterized SVG (1280x720 RGBA PNG buffers).
const sharp = require('sharp');
const { W, H } = require('./config');
const FONT = 'Arial, "Helvetica Neue", Helvetica, sans-serif';

const clamp01 = x => x < 0 ? 0 : x > 1 ? 1 : x;
const env = (t, a, b, c, d) =>            // trapezoid fade envelope over t in [0,1]
  t < a ? 0 : t < b ? (t-a)/(b-a) : t < c ? 1 : t < d ? 1-(t-c)/(d-c) : 0;
const ease = t => t<.5 ? 4*t*t*t : 1-Math.pow(-2*t+2,3)/2;

function wrap(inner) {
  return `<svg width="${W}" height="${H}" xmlns="http://www.w3.org/2000/svg">
    <defs><filter id="ds" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="3" stdDeviation="6" flood-color="#000" flood-opacity="0.85"/>
    </filter>
    <filter id="gl" x="-60%" y="-60%" width="220%" height="220%">
      <feDropShadow dx="0" dy="0" stdDeviation="16" flood-color="#bfe0ff" flood-opacity="0.7"/>
    </filter>
    <filter id="both" x="-60%" y="-60%" width="220%" height="220%">
      <feDropShadow dx="0" dy="0" stdDeviation="16" flood-color="#bfe0ff" flood-opacity="0.65" result="g"/>
      <feDropShadow in="g" dx="0" dy="3" stdDeviation="6" flood-color="#000" flood-opacity="0.85"/>
    </filter></defs>${inner}</svg>`;
}
const txt = (x,y,s,size,ls,op,fid='ds',extra='') =>
  `<text x="${x}" y="${y}" text-anchor="middle" font-family='${FONT}' font-weight="700"
    font-size="${size}" letter-spacing="${ls}" fill="#fff" fill-opacity="${op.toFixed(3)}"
    filter="url(#${fid})" ${extra}>${s}</text>`;

function build(shot, t) {
  const T = shot.text; if (!T) return null;
  let inner = '';
  if (T.kind === 'present') {
    const o = env(t,0.12,0.32,0.66,0.95);
    inner = txt(W/2, H/2-6, T.main, 64, 16, o, 'both')
          + txt(W/2, H/2+38, T.sub, 22, 14, o*0.9);
  } else if (T.kind === 'lower') {
    const o = env(t,0.10,0.30,0.78,0.96), dy = (1-ease(clamp01(t/0.3)))*26;
    inner = `<g transform="translate(0,${dy.toFixed(1)})">`
          + `<rect x="${W/2-260}" y="${H-150}" width="520" height="3" fill="#fff" fill-opacity="${(o*0.7).toFixed(3)}"/>`
          + txt(W/2, H-110, T.main, 34, 10, o) + `</g>`;
  } else if (T.kind === 'word') {
    const o = env(t,0.06,0.22,0.7,0.95), sc = 0.92 + ease(clamp01(t/0.3))*0.08;
    inner = `<g transform="translate(${W/2},${H-118}) scale(${sc.toFixed(3)}) translate(${-W/2},${-(H-118)})">`
          + txt(W/2, H-104, T.main, 52, 18, o, 'both') + `</g>`;
  } else if (T.kind === 'classes') {
    const oTitle = env(t,0.05,0.22,0.85,0.98);
    inner = txt(W/2, 150, T.main, 30, 12, oTitle);
    const xs = [W/2-420, W/2-140, W/2+140, W/2+420];
    T.items.forEach((it,i)=>{
      const o = env(t, 0.18+i*0.11, 0.30+i*0.11, 0.86, 0.99);
      const dy = (1-ease(clamp01((t-(0.18+i*0.11))/0.14)))*16;
      inner += txt(xs[i], H/2+10+dy, it, 30, 4, clamp01(o), 'both');
    });
  } else if (T.kind === 'logo') {
    const oM = env(t,0.05,0.26,1.01,1.01), sc = 0.96 + ease(clamp01(t/0.4))*0.04;
    const oS = env(t,0.30,0.5,1.01,1.01), oC = env(t,0.48,0.70,1.01,1.01);
    inner = `<g transform="translate(${W/2},${H/2-30}) scale(${sc.toFixed(3)}) translate(${-W/2},${-(H/2-30)})">`
          + txt(W/2, H/2-10, T.main, 92, 14, oM, 'both') + `</g>`
          + txt(W/2, H/2+44, T.sub, 22, 8, oS)
          + txt(W/2, H/2+108, T.cta, 23, 5, clamp01(oC), 'both');
  }
  return wrap(inner);
}

async function render(shot, t) {
  const svg = build(shot, t);
  return svg ? sharp(Buffer.from(svg)).png().toBuffer() : null;
}
module.exports = { render };
