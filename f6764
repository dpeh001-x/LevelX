// Tiny CORS upload sink for live-gameplay frame capture.
// POST /frame/<name>  body: dataURL or base64 jpeg  ->  saved to tools/teaser/gameplay/<name>.jpg
const http = require('http');
const fs = require('fs');
const path = require('path');
const os = require('os');

// Write OUTSIDE the served project dir so the preview file-watcher never reloads mid-capture.
const DIR = path.join(os.tmpdir(), 'moji_gp');
fs.rmSync(DIR, { recursive: true, force: true });
fs.mkdirSync(DIR, { recursive: true });

const PORT = 8099;
http.createServer((req, res) => {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', '*');
  if (req.method === 'OPTIONS') { res.writeHead(204); return res.end(); }
  if (req.method === 'POST' && req.url.startsWith('/frame/')) {
    const name = req.url.slice('/frame/'.length).replace(/[^a-z0-9_]/gi, '');
    let body = '';
    req.on('data', c => body += c);
    req.on('end', () => {
      const b64 = body.replace(/^data:image\/\w+;base64,/, '');
      try {
        fs.writeFileSync(path.join(DIR, name + '.jpg'), Buffer.from(b64, 'base64'));
        res.writeHead(200); res.end('ok');
      } catch (e) { res.writeHead(500); res.end(String(e)); }
    });
    return;
  }
  if (req.method === 'GET' && req.url === '/count') {
    res.writeHead(200); return res.end(String(fs.readdirSync(DIR).length));
  }
  res.writeHead(404); res.end('no');
}).listen(PORT, () => console.log('capture sink on http://localhost:' + PORT + ' -> ' + DIR));
